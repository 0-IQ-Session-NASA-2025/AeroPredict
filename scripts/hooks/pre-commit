#!/bin/bash

# Branch naming convention validation
current_branch=$(git symbolic-ref --short HEAD 2>/dev/null)

# Allow main branch for now (will be protected by pre-push hook)
if [ "$current_branch" = "main" ]; then
    exit 0
fi

